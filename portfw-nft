#!/usr/bin/env python3
"""Native nftables forwarding engine. Opt-in sidecar: never auto-replaces legacy rules."""
import argparse
import socket
import textwrap
import contextlib
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

VERSION = "2.1.0-rc3"
STATE_DIR = Path(os.environ.get("PORTFW_STATE_DIR", "/etc/iptables-forward-manager"))
RULES = STATE_DIR / "rules.db"
CACHE = STATE_DIR / "dns-cache.db"
BALANCE = STATE_DIR / "dns-balance.db"
BACKENDS = STATE_DIR / "dns-backends.db"
RULE_DNS = STATE_DIR / "dns-rules.json"
TIMER_MANAGED = STATE_DIR / "dns-timer-managed"
LOCK = Path(os.environ.get("PORTFW_LOCK", "/run/iptables-forward-manager.lock"))
TABLE = "ifm_portfw"
INTERVALS = (1, 2, 3, 5, 10, 15, 20, 30, 45, 60)
MAX_PORTS_PER_RULE = 4096
MAX_PORTS_TOTAL = 10000
MAX_RR_MAPPINGS = 50000  # Expanded destination mappings to protect memory and reload time
DNS_RE = re.compile(r"^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$")
PROTOCOLS = {"tcp": ("tcp",), "udp": ("udp",), "both": ("tcp", "udp")}


class PortfwError(Exception):
    pass


def run(cmd, *, input=None, timeout=20, check=True):
    try:
        p = subprocess.run(cmd, input=input, text=True, capture_output=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise PortfwError(f"Cannot execute {cmd[0]}: {exc}") from exc
    if check and p.returncode:
        raise PortfwError(f"{' '.join(cmd)} failed: {p.stderr.strip() or p.stdout.strip()}")
    return p


def ipv4(value):
    try:
        addr = ipaddress.IPv4Address(value)
    except ipaddress.AddressValueError:
        raise PortfwError(f"Invalid IPv4 address: {value}") from None
    if addr.is_multicast or addr.is_unspecified or addr.is_loopback:
        raise PortfwError(f"Unsafe destination IPv4 address: {value}")
    return str(addr)


def destination(value):
    try:
        return ipv4(value)
    except PortfwError:
        # An IP-like value must not slip through as a hostname.
        if re.fullmatch(r"[0-9.]+", value):
            raise
    value = value.rstrip(".").lower()
    if not DNS_RE.fullmatch(value):
        raise PortfwError(f"Invalid destination hostname: {value}")
    return value


def is_domain(value):
    return not re.fullmatch(r"[0-9.]+", value)


def ports(value):
    """Expand ordered comma lists and inclusive ranges; reject duplicates and malformed tokens."""
    if not value or not re.fullmatch(r"[0-9,\- ]+", value):
        raise PortfwError(f"Invalid port specification: {value!r}")
    result = []
    for raw in value.split(","):
        token = raw.strip()
        if not token:
            raise PortfwError("Empty port list item")
        parts = [p.strip() for p in token.split("-")]
        if len(parts) not in (1, 2) or not all(re.fullmatch(r"[0-9]+", p) for p in parts):
            raise PortfwError(f"Invalid port item: {token!r}")
        values = list(map(int, parts))
        if any(n < 1 or n > 65535 for n in values):
            raise PortfwError("Ports must be between 1 and 65535")
        if len(values) == 2 and values[0] > values[1]:
            raise PortfwError(f"Descending range: {token}")
        result.extend(range(values[0], values[-1] + 1))
        if len(result) > MAX_PORTS_PER_RULE:
            raise PortfwError(f"More than {MAX_PORTS_PER_RULE} ports per rule")
    if len(set(result)) != len(result):
        raise PortfwError("Duplicate ports in the same specification")
    return result


def make_rule(id_, source, target, dest, proto):
    if not str(id_).isdigit() or int(id_) <= 0:
        raise PortfwError("Invalid rule ID")
    source_ports, dest_ports = ports(source), ports(dest)
    if len(source_ports) != len(dest_ports):
        raise PortfwError(f"Source has {len(source_ports)} ports; destination has {len(dest_ports)}. Counts must match.")
    if proto not in PROTOCOLS:
        raise PortfwError("Protocol must be tcp, udp, or both")
    return (int(id_), source, destination(target), dest, proto)


def validate_rules(records):
    ids, occupied = set(), set()
    total = 0
    for rec in records:
        rule = make_rule(*rec)
        id_, source, _, dest, proto = rule
        if id_ in ids:
            raise PortfwError(f"Duplicate rule ID: {id_}")
        ids.add(id_)
        count = len(ports(source))
        total += count * len(PROTOCOLS[proto])
        if total > MAX_PORTS_TOTAL:
            raise PortfwError(f"More than {MAX_PORTS_TOTAL} protocol/port mappings in total")
        for p in PROTOCOLS[proto]:
            for n in ports(source):
                k = (p, n)
                if k in occupied:
                    raise PortfwError(f"Source conflict on {p}/{n}")
                occupied.add(k)
    return records


def read_rules():
    if not RULES.exists():
        return []
    result = []
    for line_no, line in enumerate(RULES.read_text().splitlines(), 1):
        if not line.strip():
            continue
        fields = line.split("|")
        if len(fields) != 5:
            raise PortfwError(f"Malformed state at line {line_no}")
        try:
            result.append(make_rule(*fields))
        except PortfwError as exc:
            raise PortfwError(f"State line {line_no}: {exc}") from exc
    return validate_rules(result)


def write_atomic(path, content):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".portfw-", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as out:
            out.write(content)
            out.flush()
            os.fsync(out.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def save_rules(records):
    write_atomic(RULES, "".join("|".join(map(str, rec)) + "\n" for rec in records))


def read_cache():
    if not CACHE.exists():
        return {}
    result = {}
    for line in CACHE.read_text().splitlines():
        parts = line.split("|")
        if len(parts) != 2:
            raise PortfwError("Malformed DNS cache")
        host, address = parts
        if not is_domain(destination(host)):
            raise PortfwError("Invalid host in DNS cache")
        result[host] = ipv4(address)
    return result


def save_cache(cache):
    write_atomic(CACHE, "".join(f"{k}|{v}\n" for k, v in sorted(cache.items())))


def read_balance():
    """Opt-in mode: minutes=0 for per-connection RR, else timed minutes."""
    if not BALANCE.exists():
        return {}
    result = {}
    for line in BALANCE.read_text().splitlines():
        fields = line.split("|")
        if len(fields) != 4:
            raise PortfwError("Malformed DNS balance state")
        host, interval, selected, last = fields
        if not is_domain(destination(host)) or host != destination(host):
            raise PortfwError("Invalid DNS balance domain")
        if host in result or not interval.isdecimal() or int(interval) not in (0, *INTERVALS):
            raise PortfwError("Invalid or duplicate DNS balance interval")
        if not last.isdecimal():
            raise PortfwError("Invalid DNS balance timestamp")
        result[host] = (int(interval), ipv4(selected), int(last))
    return result


def save_balance(config):
    content = "".join(f"{host}|{minutes}|{selected}|{last}\n"
                      for host, (minutes, selected, last) in sorted(config.items()))
    write_atomic(BALANCE, content)


def read_backends():
    """Durable resolver snapshot for RR mode; boot restore never requires DNS."""
    if not BACKENDS.exists():
        return {}
    result = {}
    for line in BACKENDS.read_text().splitlines():
        parts = line.split("|")
        if len(parts) != 2:
            raise PortfwError("Malformed DNS backend state")
        host, list_text = parts
        if not is_domain(destination(host)) or host != destination(host) or host in result:
            raise PortfwError("Invalid or duplicate backend hostname")
        values = [ipv4(address) for address in list_text.split(",") if address]
        if not values or len(values) != len(set(values)) or len(values) > 64:
            raise PortfwError("Invalid DNS backend list (1-64 distinct addresses)")
        result[host] = sorted(values, key=lambda x: int(ipaddress.IPv4Address(x)))
    return result


def save_backends(config):
    content = "".join(f"{host}|{','.join(addresses)}\n"
                      for host, addresses in sorted(config.items()))
    write_atomic(BACKENDS, content)


def validate_policy(raw):
    """Versioned, per-rule state; enforce safe typed values before nft rendering."""
    if not isinstance(raw, dict) or raw.get("mode") not in ("off", "timed", "rr"):
        raise PortfwError("Invalid DNS rule mode")
    mode = raw["mode"]
    poll = raw.get("poll", 5)
    rotate = raw.get("rotate", 5)
    selected = raw.get("selected")
    addresses = raw.get("backends")
    last = raw.get("last", 0)
    checked = raw.get("checked", 0)
    if type(poll) is not int or poll not in INTERVALS:
        raise PortfwError("DNS refresh interval must be an allowed minute value")
    if type(rotate) is not int or rotate not in INTERVALS:
        raise PortfwError("DNS rotation interval must be an allowed minute value")
    if type(last) is not int or last < 0 or type(checked) is not int or checked < 0:
        raise PortfwError("Invalid DNS timestamps")
    selected = ipv4(selected)
    if not isinstance(addresses, list) or not (1 <= len(addresses) <= 64):
        raise PortfwError("DNS backend list must contain 1-64 IPs")
    addresses = sorted([ipv4(a) for a in addresses], key=lambda a: int(ipaddress.IPv4Address(a)))
    if len(set(addresses)) != len(addresses) or selected not in addresses:
        raise PortfwError("DNS selected address must belong to unique backend records")
    return dict(mode=mode, poll=poll, rotate=rotate, selected=selected,
                backends=addresses, last=last, checked=checked)


def read_rule_dns():
    if not RULE_DNS.exists():
        return {}
    try:
        payload = json.loads(RULE_DNS.read_text())
        if not isinstance(payload, dict) or payload.get("schema") != 1 or not isinstance(payload.get("rules"), dict):
            raise PortfwError("Invalid per-rule DNS state schema")
        result = {}
        for k, value in payload["rules"].items():
            if not str(k).isdecimal() or int(k) < 1 or str(int(k)) != k:
                raise PortfwError("Invalid DNS Rule ID")
            result[int(k)] = validate_policy(value)
        return result
    except (OSError, ValueError, TypeError) as exc:
        raise PortfwError(f"Malformed per-rule DNS state: {exc}") from exc


def save_rule_dns(policies):
    normalized = {str(int(rid)): validate_policy(v) for rid, v in policies.items()}
    write_atomic(RULE_DNS, json.dumps({"schema": 1, "rules": normalized},
                                       sort_keys=True, indent=2) + "\n")


def create_rule_policy(mode, minutes, rotation, addresses, *, previous=None):
    if mode not in ("off", "timed", "rr"):
        raise PortfwError("Choose OFF, TIMED or PER-CONNECTION RR")
    if minutes not in INTERVALS or rotation not in INTERVALS:
        raise PortfwError(f"Allowed intervals: {', '.join(map(str, INTERVALS))}")
    if not isinstance(addresses, list) or not addresses:
        raise PortfwError("Domain resolution returned no IPv4 A records")
    if len(addresses) > 64:
        raise PortfwError("At most 64 IPv4 A records are supported")
    if mode != "off" and len(addresses) < 2:
        raise PortfwError("Balancing needs two or more IPv4 A records")
    now = int(time.time())
    prior = validate_policy(previous) if previous else None
    choice = prior["selected"] if prior and prior["selected"] in addresses else addresses[0]
    last = prior["last"] if prior and prior["mode"] == mode else now
    return validate_policy(dict(mode=mode, poll=minutes, rotate=rotation,
            selected=choice, backends=addresses, last=last, checked=now))


def legacy_policy(rule, legacy_balance, legacy_backends, cache, timer_minutes):
    """Read-only fallback preserves older per-domain settings during upgrade."""
    rid, _, host, _, _ = rule
    selected = cache.get(host)
    if not selected:
        raise PortfwError(f"No cached IP for legacy DNS rule {rid} ({host})")
    old = legacy_balance.get(host)
    if old:
        interval, choice, last = old
        mode = "rr" if interval == 0 else "timed"
        values = legacy_backends.get(host, [choice]) if mode == "rr" else [choice]
        if selected not in values:
            values = sorted(set([*values, selected]), key=lambda v: int(ipaddress.IPv4Address(v)))
        return validate_policy(dict(mode=mode, poll=timer_minutes, rotate=interval or 5,
                selected=selected, backends=values, last=last, checked=0))
    return validate_policy(dict(mode="off", poll=timer_minutes, rotate=5,
            selected=selected, backends=[selected], last=0, checked=0))


@contextlib.contextmanager
def locked():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def resolve_all(host):
    """Return all unique eligible A records in deterministic numeric order."""
    result = run(["getent", "ahostsv4", host], timeout=5)
    addresses = set()
    for line in result.stdout.splitlines():
        item = line.split()[0] if line.split() else ""
        try:
            addresses.add(ipv4(item))
        except PortfwError:
            continue
    if not addresses:
        raise PortfwError(f"No usable IPv4 A record for {host}")
    return sorted(addresses, key=lambda a: int(ipaddress.IPv4Address(a)))


def resolve(host):
    # Legacy stable-selection behavior unless explicit balancing is enabled.
    return resolve_all(host)[0]


def next_rotation(current, addresses, last, interval, now):
    """Choose a new target only when the interval expires or target disappears."""
    if not addresses:
        raise PortfwError("Cannot rotate without eligible IPv4 addresses")
    if current not in addresses:
        return addresses[0], now
    if len(addresses) < 2 or now - last < interval * 60:
        return current, last
    return addresses[(addresses.index(current) + 1) % len(addresses)], now


def configure_balance(rule_id, enable, minutes=5, mode="timed"):
    """Legacy CLI entrypoint; edits modern per-rule policy when present."""
    modern = read_rule_dns().get(rule_id)
    if modern is not None:
        row = next((r for r in read_rules() if r[0] == rule_id), None)
        if row is None:
            raise PortfwError("Rule ID not found")
        target_mode = ("rr" if mode == "round-robin" else "timed") if enable else "off"
        addresses = resolve_all(row[2]) if enable else modern["backends"]
        # Use same single edit transaction as the interactive menu.
        change("edit", argparse.Namespace(id=row[0], source=row[1], target=row[2],
              dest=row[3], protocol=row[4], dns_mode=target_mode,
              dns_poll=modern["poll"], dns_rotate=minutes,
              dns_addresses=addresses))
        return
    if enable and mode not in ("timed", "round-robin"):
        raise PortfwError("Mode must be timed or round-robin")
    if enable and mode == "timed" and minutes not in INTERVALS:
        raise PortfwError(f"Allowed intervals in minutes: {INTERVALS}")
    with locked():
        rules = read_rules()
        rule = next((r for r in rules if r[0] == rule_id), None)
        if rule is None:
            raise PortfwError(f"Rule ID {rule_id} not found")
        host = rule[2]
        if not is_domain(host):
            raise PortfwError("Balancing is available only for domain destinations")
        config = read_balance()
        old_config = dict(config)
        backends = read_backends()
        old_backends = dict(backends)
        cache = read_cache()
        current = cache.get(host)
        if not current:
            raise PortfwError("No cached destination for this domain; run DNS Refresh first")
        if enable:
            addresses = resolve_all(host)
            if len(addresses) < 2:
                raise PortfwError(f"{host} needs at least two A records to enable balancing")
            if len(addresses) > 64:
                raise PortfwError("At most 64 A records are supported for balancing")
            if current not in addresses:
                raise PortfwError("Current cached IP is not in DNS answers; run dns-refresh before enabling")
            previous = config.get(host)
            interval = minutes if mode == "timed" else 0
            last = (previous[2] if previous and previous[0] == interval
                    and previous[1] == current else int(time.time()))
            config[host] = (interval, current, last)
            if mode == "round-robin":
                backends[host] = addresses
            else:
                backends.pop(host, None)
        else:
            config.pop(host, None)
            backends.pop(host, None)
        # Installing/removing a kernel per-flow RR map must be a validated
        # transaction; never leave persistent mode different from live kernel.
        kernel_changed = (old_config.get(host, (None,))[0] == 0) != (
            config.get(host, (None,))[0] == 0)
        if old_backends.get(host) != backends.get(host):
            kernel_changed = True
        if kernel_changed:
            apply(rules, cache, balance=config, backends=backends)
        try:
            save_balance(config)
            save_backends(backends)
        except OSError as exc:
            try:
                if kernel_changed:
                    apply(rules, cache, balance=old_config, backends=old_backends)
                save_balance(old_config)
                save_backends(old_backends)
            except (OSError, PortfwError) as rollback_exc:
                print(f"CRITICAL: balance rollback failed: {rollback_exc}", file=sys.stderr)
            raise PortfwError(f"Could not persist balance mode: {exc}") from exc
        if not enable:
            print(f"DNS balancing OFF for {host}; stable destination={current}")
        elif mode == "timed":
            print(f"DNS timed rotation: {host} every {minutes}min; current={current}; "
                  f"A records={', '.join(addresses)}")
        else:
            print(f"DNS per-connection ROUND ROBIN: {host}; "
                  f"{len(addresses)} backends={', '.join(addresses)}")
        if enable and not _dns_is_enabled():
            print("WARNING: DNS poll timer is disabled. For timed rotation, "
                  "enable it with 'portfw-nft timer --minutes 1 --enable'; "
                  "for per-connection RR, enable polling to discover A record changes.",
                  file=sys.stderr)


def show_balance():
    modern = read_rule_dns()
    rules = read_rules()
    if modern:
        for rid, _, host, _, _ in rules:
            if rid not in modern:
                continue
            p = modern[rid]
            print(f"Rule #{rid}: {host} / mode={p['mode'].upper()} / "
                  f"DNS interval={p['poll']}min / rotation={p['rotate']}min / "
                  f"selected={p['selected']} / IPs={', '.join(p['backends'])}")
    config = read_balance()
    all_hosts = sorted({r[2] for r in rules if is_domain(r[2])})
    backends = read_backends()
    cache = read_cache()
    if not all_hosts:
        print("DNS balancing: no domain forwarding rules configured")
    now = int(time.time())
    for host in all_hosts:
        ids = ",".join(str(r[0]) for r in rules if r[2] == host)
        current = cache.get(host, "N/A")
        if host not in config:
            print(f"{host} | rule IDs={ids} | mode=OFF | stable={current}")
            continue
        minutes, selected, last = config[host]
        if minutes == 0:
            targets = backends.get(host, [selected])
            print(f"{host} | rule IDs={ids} | mode=PER-CONNECTION RR | "
                  f"backends={len(targets)} | IPs={', '.join(targets)}")
        else:
            remaining = max(0, (minutes * 60 - (now - last) + 59) // 60)
            print(f"{host} | rule IDs={ids} | mode=TIMED | current={current} "
                  f"| rotate every {minutes}min | due in ~{remaining}min")
    print(f"DNS poll timer: {'enabled' if _dns_is_enabled() else 'DISABLED'}")


def primary_ipv4():
    result = run(["ip", "-4", "route", "get", "1.1.1.1"], timeout=5)
    match = re.search(r"\bsrc\s+(\d+\.\d+\.\d+\.\d+)", result.stdout)
    if not match:
        raise PortfwError("Cannot detect primary IPv4")
    return ipv4(match.group(1))


def legacy_active():
    if not shutil.which("iptables"):
        return False
    p = run(["iptables", "-w", "2", "-t", "nat", "-C", "PREROUTING", "-j", "IFM_DNAT"], check=False, timeout=5)
    return p.returncode == 0


def table_exists():
    return run(["nft", "list", "table", "ip", TABLE], check=False, timeout=5).returncode == 0


def nft_config(records, cache, primary, *, existing=False, balance=None, backends=None, policies=None):
    """Render owned table with O(1) port dispatch into rule-specific kernel RR."""
    validate_rules(records)
    primary = ipv4(primary)
    balance = {} if balance is None else balance
    backends = {} if backends is None else backends
    policies = {} if policies is None else policies
    maps = {"tcp": [], "udp": []}
    # Each RR rule gets its own numgen expression and its own per-port remap.
    rr_rules = {"tcp": [], "udp": []}
    fw = {"tcp": set(), "udp": set()}
    snat = {"tcp": set(), "udp": set()}
    rr_total = 0
    for rid, source, target, dest, protocol in records:
        policy = validate_policy(policies[rid]) if rid in policies else None
        selected = (policy["selected"] if policy else
                    cache.get(target) if is_domain(target) else target)
        if not selected:
            raise PortfwError(f"No DNS cache for {target}; run dns-refresh first")
        selected = ipv4(selected)
        rr_enabled = (policy["mode"] == "rr" if policy else
                      is_domain(target) and target in balance and balance[target][0] == 0)
        targets = (policy["backends"] if rr_enabled and policy else
                   backends.get(target) if rr_enabled else [selected])
        if not targets:
            raise PortfwError(f"No durable backend A records for RR domain {target}")
        targets = sorted({ipv4(x) for x in targets}, key=lambda x: int(ipaddress.IPv4Address(x)))
        mappings = list(zip(ports(source), ports(dest)))
        for proto in PROTOCOLS[protocol]:
            if rr_enabled and len(targets) > 1:
                rr_total += len(targets) * len(mappings)
                if rr_total > MAX_RR_MAPPINGS:
                    raise PortfwError(f"Too many expanded RR endpoints; limit {MAX_RR_MAPPINGS}")
                rr_rules[proto].append((rid, mappings, targets))
            else:
                maps[proto].extend((sp, targets[0], dp) for sp, dp in mappings)
            for sp, dp in mappings:
                for ip in targets:
                    fw[proto].add((ip, dp))
                    snat[proto].add((ip, dp, sp))
    lines = []
    if existing:
        lines.append(f"delete table ip {TABLE}")
    lines.append(f"add table ip {TABLE}")
    for proto in ("tcp", "udp"):
        lines.extend([
            f"add map ip {TABLE} {proto}_dnat {{ type inet_service : ipv4_addr . inet_service; }}",
            f"add set ip {TABLE} {proto}_forward {{ type ipv4_addr . inet_service; }}",
            f"add set ip {TABLE} {proto}_snat {{ type ipv4_addr . inet_service . inet_service; }}",
        ])
        if maps[proto]:
            values = ", ".join(f"{sp} : {ip} . {dp}" for sp, ip, dp in sorted(maps[proto]))
            lines.append(f"add element ip {TABLE} {proto}_dnat {{ {values} }}")
        if rr_rules[proto]:
            lines.append(f"add map ip {TABLE} {proto}_rr_dispatch {{ type inet_service : verdict; }}")
        for rid, mappings, targets in rr_rules[proto]:
            chain = f"{proto}_rr_{rid}"
            portmap = f"{proto}_rr_ports_{rid}"
            lines.extend([
                f"add chain ip {TABLE} {chain}",
                f"add map ip {TABLE} {portmap} {{ type inet_service : inet_service; }}",
            ])
            destinations = ", ".join(f"{sp} : {dp}" for sp, dp in mappings)
            lines.append(f"add element ip {TABLE} {portmap} {{ {destinations} }}")
            ipmap = ", ".join(f"{i} : {ip}" for i, ip in enumerate(targets))
            lines.append(
                f"add rule ip {TABLE} {chain} ip protocol {proto} dnat ip to numgen inc mod {len(targets)} "
                f"map {{ {ipmap} }} : {proto} dport map @{portmap}"
            )
        if rr_rules[proto]:
            dispatch = ", ".join(f"{sp} : jump {proto}_rr_{rid}"
                                 for rid, mappings, _ in rr_rules[proto] for sp, _ in mappings)
            lines.append(f"add element ip {TABLE} {proto}_rr_dispatch {{ {dispatch} }}")
        if fw[proto]:
            targets = ", ".join(f"{ip} . {dp}" for ip, dp in sorted(fw[proto]))
            lines.append(f"add element ip {TABLE} {proto}_forward {{ {targets} }}")
            origins = ", ".join(f"{ip} . {dp} . {sp}" for ip, dp, sp in sorted(snat[proto]))
            lines.append(f"add element ip {TABLE} {proto}_snat {{ {origins} }}")
    lines.extend([
        f"add chain ip {TABLE} prerouting {{ type nat hook prerouting priority -101; policy accept; }}",
        f"add chain ip {TABLE} postrouting {{ type nat hook postrouting priority 99; policy accept; }}",
        f"add chain ip {TABLE} forwarding {{ type filter hook forward priority -5; policy accept; }}",
        f"add rule ip {TABLE} forwarding ct state established,related accept",
    ])
    for proto in ("tcp", "udp"):
        if maps[proto]:
            lines.append(f"add rule ip {TABLE} prerouting fib daddr type local ip protocol {proto} "
                         f"dnat ip addr . port to {proto} dport map @{proto}_dnat")
        if rr_rules[proto]:
            lines.append(f"add rule ip {TABLE} prerouting fib daddr type local ip protocol {proto} "
                         f"{proto} dport vmap @{proto}_rr_dispatch")
        if fw[proto]:
            lines.extend([
                f"add rule ip {TABLE} forwarding ct status dnat ip protocol {proto} "
                f"ip daddr . {proto} dport @{proto}_forward accept",
                f"add rule ip {TABLE} postrouting ct status dnat ip protocol {proto} "
                f"ip daddr . {proto} dport . ct original proto-dst @{proto}_snat "
                f"snat to {primary}",
            ])
    return "\n".join(lines) + "\n"


def apply(records, cache, *, balance=None, backends=None, policies=None):
    if legacy_active():
        raise PortfwError("Legacy IFM_DNAT jump is active. Refusing overlapping NAT. Perform a controlled maintenance migration.")
    if not shutil.which("nft"):
        raise PortfwError("nft executable not installed")
    primary = primary_ipv4()
    if balance is None:
        balance = read_balance()
    if backends is None:
        backends = read_backends()
    if policies is None:
        policies = read_rule_dns()
    script = nft_config(records, cache, primary, existing=table_exists(),
                        balance=balance, backends=backends, policies=policies)
    run(["sysctl", "-w", "net.ipv4.ip_forward=1"], timeout=5)
    run(["nft", "-c", "-f", "-"], input=script, timeout=15)
    run(["nft", "-f", "-"], input=script, timeout=15)


def updated_records(action, args, records):
    records = list(records)
    if action == "add":
        new_id = max((r[0] for r in records), default=0) + 1
        records.append(make_rule(new_id, args.source, args.target, args.dest, args.protocol))
    elif action == "edit":
        if not any(r[0] == args.id for r in records):
            raise PortfwError("Rule ID not found")
        records = [make_rule(args.id, args.source, args.target, args.dest, args.protocol) if r[0] == args.id else r for r in records]
    elif action == "delete":
        if not any(r[0] == args.id for r in records):
            raise PortfwError("Rule ID not found")
        records = [r for r in records if r[0] != args.id]
    elif action == "clear":
        records = []
    return validate_rules(records)


def _enable_persistence_after_first_add():
    """Register the restore service for future boots, without reapplying live NAT.

    Called only after the first rule has been applied and saved successfully.
    Explicit service disable on an existing installation is not overridden.
    """
    unit = "portfw-nft.service"
    try:
        state = run(["systemctl", "is-enabled", unit], timeout=5, check=False)
        if state.stdout.strip() == "enabled":
            return
        if state.stdout.strip() != "disabled":
            raise PortfwError(f"Service {unit} is not available for enabling: "
                              f"{state.stdout.strip() or state.stderr.strip()}")
        # No --now: the first add already populated the kernel nftables table.
        run(["systemctl", "enable", unit], timeout=15)
        print("Boot persistence enabled: portfw-nft.service")
    except PortfwError as exc:
        # The rule is already live and saved; don't claim its application failed.
        print(f"WARNING: Forwarding rule is active, but automatic boot restore "
              f"could not be enabled: {exc}. Check 'systemctl enable {unit}'.",
              file=sys.stderr)


def _sync_dns_timer(records):
    """One minute scheduler tick; domain rules carry their own 1-60m poll cadence."""
    has_domains = any(is_domain(r[2]) for r in records)
    if has_domains:
        enabled = _dns_is_enabled()
        if _dns_configured_minutes() != 1:
            configure_timer(1, None)
        active = run(["systemctl", "is-active", "portfw-dns-refresh.timer"],
                     check=False, timeout=5).stdout.strip() == "active"
        if not enabled or not active:
            configure_timer(None, True)
            if not enabled:
                write_atomic(TIMER_MANAGED, "auto-managed\n")
        # A timer that was left disabled must not silently remain so.
        if not _dns_is_enabled():
            raise PortfwError("DNS timer failed to enable")
    elif TIMER_MANAGED.exists():
        configure_timer(None, False)
        TIMER_MANAGED.unlink()


def change(action, args):
    """Atomic rule + DNS mode transaction with best-effort timer/firewall rollback."""
    first_add = False
    with locked():
        records = read_rules()
        first_add = action == "add" and not records
        old_cache = read_cache()
        cache = dict(old_cache)
        proposed = updated_records(action, args, records)
        old_balance = read_balance()
        old_backends = read_backends()
        old_policies = read_rule_dns()
        policies = dict(old_policies)
        new_hosts = {r[2] for r in proposed if is_domain(r[2])}
        next_balance = {k: v for k, v in old_balance.items() if k in new_hosts}
        next_backends = {k: v for k, v in old_backends.items()
                         if k in next_balance and next_balance[k][0] == 0}
        for host in sorted(new_hosts):
            if host not in cache:
                cache[host] = resolve(host)
        new_cache = {k: v for k, v in cache.items() if k in new_hosts}
        active_ids = {r[0] for r in proposed if is_domain(r[2])}
        policies = {rid: cfg for rid, cfg in policies.items() if rid in active_ids}
        for rec in proposed:
            rid, _, host, _, _ = rec
            if not is_domain(host):
                continue
            previous_rule = next((r for r in records if r[0] == rid), None)
            same_target = previous_rule is not None and previous_rule[2] == host
            override = action in ("add", "edit") and rid == (
                proposed[-1][0] if action == "add" else getattr(args, "id", -1)
            )
            # Existing upgraded policies are preserved on ordinary edits/CLI.
            if same_target and rid in policies and not (override and getattr(args, "dns_mode", None)):
                continue
            if same_target and rid not in policies and not (override and getattr(args, "dns_mode", None)):
                continue  # Preserve untouched legacy mode until explicit user edit.
            if override or not same_target:
                mode = getattr(args, "dns_mode", "off") or "off"
                poll = getattr(args, "dns_poll", 5) or 5
                rotate = getattr(args, "dns_rotate", 5) or 5
                addresses = getattr(args, "dns_addresses", None)
                if addresses is None:
                    addresses = resolve_all(host)
                previous = policies.get(rid) if same_target else None
                policies[rid] = create_rule_policy(mode, poll, rotate, addresses,
                                                   previous=previous)
        # Validate live nft transaction before any state files are changed.
        apply(proposed, new_cache, balance=next_balance,
              backends=next_backends, policies=policies)
        try:
            save_rules(proposed)
            save_cache(new_cache)
            if next_balance != old_balance:
                save_balance(next_balance)
            if next_backends != old_backends:
                save_backends(next_backends)
            if policies != old_policies:
                save_rule_dns(policies)
            # Auto-enable after persistence. Failure is NOT reported as success.
            if action != "clear" or records:
                _sync_dns_timer(proposed)
        except (OSError, PortfwError) as exc:
            try:
                apply(records, old_cache, balance=old_balance,
                      backends=old_backends, policies=old_policies)
                save_rules(records)
                save_cache(old_cache)
                save_balance(old_balance)
                save_backends(old_backends)
                save_rule_dns(old_policies)
                _sync_dns_timer(records)
            except (OSError, PortfwError) as rollback_exc:
                print(f"CRITICAL: rollback failed: {rollback_exc}", file=sys.stderr)
            raise PortfwError(f"Change rejected (DNS timer/state): {exc}") from exc
    if first_add:
        _enable_persistence_after_first_add()
    print(f"{action}: OK")


def refresh_dns():
    """One shared 1m scheduler: independent per-rule DNS polling and rotation."""
    with locked():
        records = read_rules()
        old_policies = read_rule_dns()
        now = int(time.time())
        due = set()
        for rid, _, host, _, _ in records:
            if not is_domain(host):
                continue
            policy = old_policies.get(rid)
            if policy is None or now >= policy["checked"] + policy["poll"] * 60:
                due.add(host)
        hosts = {r[2] for r in records if is_domain(r[2])}
    if not hosts:
        print("DNS: no domains configured; no firewall changes")
        return
    answers = {}
    for host in sorted(due):
        try:
            answers[host] = resolve_all(host)
        except PortfwError as exc:
            print(f"DNS warning: {exc}; keeping last known good IP", file=sys.stderr)
    with locked():
        records = read_rules()
        hosts = {r[2] for r in records if is_domain(r[2])}
        old_cache = read_cache()
        cache = dict(old_cache)
        balance = read_balance()
        new_balance = dict(balance)
        old_backends = read_backends()
        backends = dict(old_backends)
        old_policies = read_rule_dns()
        policies = {rid: dict(value) for rid, value in old_policies.items()}
        now = int(time.time())
        legacy_hosts = {r[2] for r in records if is_domain(r[2]) and r[0] not in policies}
        for host in hosts & answers.keys():
            addresses = answers[host]
            if host in legacy_hosts:
                if host in balance:
                    minutes, selected, last = balance[host]
                    if minutes == 0:
                        backends[host] = addresses
                        current = cache.get(host, selected)
                        chosen = current if current in addresses else addresses[0]
                        cache[host] = chosen
                        new_balance[host] = (0, chosen, last)
                    else:
                        current = cache.get(host, selected)
                        chosen, next_last = next_rotation(current, addresses, last, minutes, now)
                        cache[host] = chosen
                        new_balance[host] = (minutes, chosen, next_last)
                else:
                    cache[host] = addresses[0]
        for rid, _, host, _, _ in records:
            if rid not in policies or not is_domain(host):
                continue
            prior = policies[rid]
            if now >= prior["checked"] + prior["poll"] * 60 and host in answers:
                prior["backends"] = answers[host]
                prior["checked"] = now
            addresses = prior["backends"]
            if prior["mode"] == "timed":
                chosen, last = next_rotation(prior["selected"], addresses, prior["last"],
                                             prior["rotate"], now)
                prior["selected"] = chosen
                prior["last"] = last
            elif prior["selected"] not in addresses:
                prior["selected"] = addresses[0]
            policies[rid] = validate_policy(prior)
        new_cache = {k: v for k, v in cache.items() if k in hosts}
        def dataplane(policy):
            # OFF and TIMED use only the selected backend in kernel; changes
            # to unused A records must not disturb live sessions.
            return (policy["mode"], policy["selected"],
                    tuple(policy["backends"]) if policy["mode"] == "rr" else ())
        policy_change = any(
            rid in old_policies and dataplane(value) != dataplane(old_policies[rid])
            for rid, value in policies.items()
        )
        changed = new_cache != old_cache or backends != old_backends or policy_change
        if not changed and policies == old_policies and balance == new_balance:
            print("DNS: unchanged; firewall untouched")
            return
        if changed:
            apply(records, new_cache, balance=new_balance, backends=backends,
                  policies=policies)
        try:
            if new_cache != old_cache:
                save_cache(new_cache)
            if new_balance != balance:
                save_balance(new_balance)
            if backends != old_backends:
                save_backends(backends)
            if policies != old_policies:
                save_rule_dns(policies)
        except OSError as exc:
            try:
                if changed:
                    apply(records, old_cache, balance=balance, backends=old_backends,
                          policies=old_policies)
                save_cache(old_cache)
                save_balance(balance)
                save_backends(old_backends)
                save_rule_dns(old_policies)
            except (OSError, PortfwError) as rollback_exc:
                print(f"CRITICAL: DNS scheduler rollback failed: {rollback_exc}", file=sys.stderr)
            raise PortfwError(f"Could not persist DNS updates: {exc}") from exc
        if changed:
            for rid in sorted(policies):
                if rid in old_policies and dataplane(policies[rid]) != dataplane(old_policies[rid]):
                    print(f"DNS rule #{rid}: mode={policies[rid]['mode']} -> {policies[rid]['selected']}")
            for host in sorted(hosts):
                if host in legacy_hosts and old_cache.get(host) != new_cache.get(host):
                    print(f"DNS target: {host} -> {new_cache[host]}")
            print("DNS: changes applied atomically")
        else:
            print("DNS: checked; firewall untouched")


def configure_timer(minutes=None, enable=None):
    if minutes is not None and minutes not in INTERVALS:
        raise PortfwError(f"Interval must be one of {INTERVALS}")
    if any(is_domain(r[2]) for r in read_rules()):
        # The scheduler runs every minute; each rule has its own polling cadence.
        # Blocking manual disable prevents silent stale domain forwarding.
        if enable is False:
            raise PortfwError("DNS timer is managed automatically while domain rules exist")
        if minutes is not None and minutes != 1:
            raise PortfwError("Scheduler tick is fixed at 1 minute; customize DNS under Edit Forwarding")
    dropin = Path("/etc/systemd/system/portfw-dns-refresh.timer.d/override.conf")
    if minutes is not None:
        write_atomic(dropin, f"[Timer]\nOnUnitInactiveSec=\nOnUnitInactiveSec={minutes}min\nAccuracySec=30s\n")
        run(["systemctl", "daemon-reload"])
    if enable is not None:
        run(["systemctl", "enable" if enable else "disable", "--now", "portfw-dns-refresh.timer"])
    print("DNS timer settings updated")


# Terminal UI deliberately separate from the data-plane / nftables engine.
# Non-interactive commands and root-owned state keep their original behavior.
ANSI = {
    "red": "31", "green": "32", "yellow": "33", "blue": "34",
    "magenta": "35", "cyan": "36", "white": "37", "dim": "2",
    "bold": "1",
}
PANEL_WIDTH = 64


def _has_color():
    return sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb" and "NO_COLOR" not in os.environ


def _paint(value, color):
    text = str(value)
    return f"\033[{ANSI[color]}m{text}\033[0m" if _has_color() else text


def _screen():
    if sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb":
        print("\033[2J\033[H", end="")


def _panel_border(left, mid, right):
    print(_paint(left + mid * (PANEL_WIDTH + 2) + right, "cyan"))


def _panel_row(label, value, color="white"):
    # Wrap long Floating IP lists rather than truncate an address.
    name = f"{label}:"
    available = max(8, PANEL_WIDTH - len(name) - 2)
    segments = textwrap.wrap(
        str(value), width=available, break_long_words=True,
        break_on_hyphens=False
    ) or [""]
    for idx, segment in enumerate(segments):
        prefix = name if idx == 0 else " " * len(name)
        plain = f"{prefix} {segment}"
        padding = " " * max(0, PANEL_WIDTH - len(plain))
        print(
            _paint("│", "cyan") + " "
            + _paint(prefix, "yellow") + " " + _paint(segment, color)
            + padding + " " + _paint("│", "cyan")
        )


def _panel_host_interface(host, interface):
    # Keep the two fields on the same first line like the legacy v1.1 dashboard.
    first = f"Host: {host}"
    second = f"Interface: {interface}"
    gap_size = max(3, 31 - len(first))
    plain = first + " " * gap_size + second
    if len(plain) > PANEL_WIDTH:
        _panel_row("Host", host)
        _panel_row("Interface", interface)
        return
    pad = " " * (PANEL_WIDTH - len(plain))
    print(
        _paint("│", "cyan") + " "
        + _paint("Host:", "yellow") + " " + str(host)
        + " " * gap_size
        + _paint("Interface:", "yellow") + " " + str(interface)
        + pad + " " + _paint("│", "cyan")
    )


def _ip_command(*args):
    # Information-only commands; failure must never alter the firewall.
    try:
        return run(["ip", *args], timeout=3).stdout
    except PortfwError:
        return ""


def _interface():
    route = _ip_command("-4", "route", "show", "default")
    for line in route.splitlines():
        parts = line.split()
        if "dev" in parts:
            index = parts.index("dev")
            if index + 1 < len(parts):
                return parts[index + 1]
    return ""


def _interface_addresses(interface, family):
    if not interface:
        return []
    output = _ip_command(f"-{family}", "-o", "addr", "show", "dev", interface, "scope", "global")
    addresses = []
    marker = "inet" if family == 4 else "inet6"
    for line in output.splitlines():
        parts = line.split()
        if marker in parts:
            index = parts.index(marker)
            if index + 1 < len(parts):
                ip = parts[index + 1].split("/", 1)[0]
                if ip not in addresses:
                    addresses.append(ip)
    return addresses


def _server_info(records=None):
    hostname = socket.gethostname()
    interface = _interface()
    try:
        primary = primary_ipv4()
    except PortfwError:
        primary = "N/A"
    v4 = [address for address in _interface_addresses(interface, 4) if address != primary]
    v6 = _interface_addresses(interface, 6)
    return {
        "host": hostname, "interface": interface or "N/A", "primary": primary,
        "other_ipv4": ", ".join(v4) if v4 else "None",
        "ipv6": ", ".join(v6) if v6 else "None",
        "count": len(read_rules() if records is None else records),
    }


def print_header(records=None):
    _screen()
    print(_paint("Port Forward Manager", "cyan") + _paint("  |  ", "dim")
          + _paint(f"Native nftables v{VERSION}", "yellow"))
    print(_paint("Persistent IPv4 forwarding with managed nftables maps and sets.", "dim"))
    print()
    info = _server_info(records)
    _panel_border("┌", "─", "┐")
    _panel_host_interface(info["host"], info["interface"])
    _panel_row("Primary IPv4", info["primary"], "green")
    _panel_row("Other IPv4", info["other_ipv4"], "white")
    _panel_row("IPv6", info["ipv6"], "white")
    _panel_row("Managed rules", info["count"], "magenta")
    _panel_border("└", "─", "┘")
    print()


def _menu_item(key, label, description, color):
    print(_paint(f"[{key}] ", "bold") + _paint(f"{label:<20}", color)
          + " " + _paint(description, "dim"))


def _heading(label, subtitle, color="cyan"):
    print()
    print(_paint(label, color) + "  " + _paint(subtitle, "dim"))
    print(_paint("─" * 62, "dim"))


def _prompt(label, default=None, color="cyan"):
    suffix = f" [{default}]" if default is not None else ""
    answer = input(_paint(label, color) + _paint(suffix, "dim") + ": ").strip()
    return answer if answer else (default if default is not None else "")


def _pause():
    input("\n" + _paint("Press Enter to continue...", "dim"))


def _rule_columns(records):
    headers = ("ID", "Source Port(s)", "Destination IP / Domain", "Destination Port(s)", "Protocol")
    values = [(str(r[0]), r[1], r[2], r[3],
               "TCP+UDP" if r[4] == "both" else r[4].upper()) for r in records]
    minimum = (3, 14, 23, 19, 8)
    maximum = (5, 24, 36, 24, 9)
    widths = [min(max(minimum[i], len(headers[i]),
                      max((len(str(row[i])) for row in values), default=0)), maximum[i])
              for i in range(len(headers))]
    return headers, values, widths


def list_rules(records):
    headers, rows, widths = _rule_columns(records)
    print()
    print(_paint("Managed Forwarding Rules", "cyan"))
    def cells(values):
        return "  ".join(str(value).ljust(width) for value, width in zip(values, widths))
    print(_paint(cells(headers), "cyan"))
    print(_paint(cells(["─" * width for width in widths]), "dim"))
    colors = ("white", "green", "blue", "magenta", "yellow")
    for row in rows:
        wrapped = [textwrap.wrap(str(value), width=width,
                    break_long_words=True, break_on_hyphens=False) or [""]
                   for value, width in zip(row, widths)]
        for index in range(max(map(len, wrapped))):
            values = [chunks[index] if index < len(chunks) else "" for chunks in wrapped]
            print("  ".join(
                _paint(value.ljust(width), color)
                for value, width, color in zip(values, widths, colors)
            ))
    if not rows:
        print(_paint("No forwarding rules configured.", "dim"))
    if records:
        policies = read_rule_dns()
        legacy = read_balance()
        print(_paint("Traffic distribution / DNS updates:", "cyan"))
        for rid, _, host, _, _ in records:
            if not is_domain(host):
                continue
            if rid in policies:
                policy = policies[rid]
                mode = {"off": "SINGLE IP", "timed": f"TIMED {policy['rotate']}m",
                        "rr": f"PER-CONNECTION RR x{len(policy['backends'])}"}[policy["mode"]]
                summary = f"Rule #{rid}: {mode} | DNS every {policy['poll']}m"
            elif host in legacy:
                interval = legacy[host][0]
                mode = f"LEGACY TIMED {interval}m" if interval else "LEGACY RR"
                summary = f"Rule #{rid}: {mode}"
            else:
                summary = f"Rule #{rid}: SINGLE IP | legacy DNS timer"
            print(_paint("  " + summary, "green"))
    print()


def _entry(existing=None):
    defaults = existing or ("", "", "", "both")
    for i, (field, color) in enumerate((
        ("Source port(s) — e.g. 2001-2005,2010", "green"),
        ("Destination IPv4 or domain", "blue"),
        ("Destination port(s) — one-to-one mapping", "magenta"),
        ("Protocol (tcp/udp/both)", "yellow"),
    )):
        # The inner prompts loop to handle invalid data without discarding earlier entries.
        while True:
            value = _prompt(field, defaults[i] if (existing or i == 3) else None, color)
            try:
                if i in (0, 2):
                    ports(value)
                elif i == 1:
                    destination(value)
                elif value not in PROTOCOLS:
                    raise PortfwError("Choose tcp, udp or both")
                break
            except PortfwError as exc:
                print(_paint(f"Invalid value: {exc}", "red"))
        if i == 0:
            source = value
        elif i == 1:
            target = value
        elif i == 2:
            dest = value
        else:
            proto = value.lower()
    # Ensure malformed cardinality or overlapping ports fail before the apply operation.
    make_rule(1, source, target, dest, proto)
    return source, target, dest, proto


def _rule_dns_form(rule_id, target, existing=None):
    """All balancing and refresh controls appear in the Add/Edit workflow."""
    if not is_domain(target):
        print(_paint("IPv4 destination: DNS updates and balancing not required.", "dim"))
        return None
    addresses = resolve_all(target)
    old = existing or {}
    poll = old.get("poll", 5)
    rotation = old.get("rotate", 5)
    mode = old.get("mode", "off")
    if len(addresses) < 2:
        mode = "off"
    _heading("Destination DNS", "Automatically managed for this rule", "cyan")
    _panel_border("┌", "─", "┐")
    _panel_row("Domain", target)
    _panel_row("IPv4 A records", len(addresses), "green")
    _panel_row("Addresses", ", ".join(addresses), "white")
    _panel_border("└", "─", "┘")
    if len(addresses) >= 2:
        print()
        _menu_item("1", "Single IP (OFF)", "Default: stable selection; DNS still updates", "white")
        _menu_item("2", "Timed Rotation", "Rotate NEW connections after each time slot", "cyan")
        _menu_item("3", "Per-Connection RR", "Distribute new flows natively in kernel", "green")
        options = {"off": "1", "timed": "2", "rr": "3"}
        selected = _prompt("Traffic Distribution", options[mode], "yellow")
        if selected not in ("1", "2", "3"):
            raise PortfwError("Choose a valid traffic distribution mode")
        mode = {"1": "off", "2": "timed", "3": "rr"}[selected]
    else:
        print(_paint("Only one IP found: Single IP mode (no balancing).", "yellow"))
    if mode == "timed":
        value = _prompt("Rotation interval (minutes)", str(rotation), "cyan")
        if not value.isdecimal() or int(value) not in INTERVALS:
            raise PortfwError(f"Allowed rotation intervals: {INTERVALS}")
        rotation = int(value)
    default_poll = 1 if mode == "timed" else 5
    if old and old.get("mode") == mode:
        default_poll = poll
    print(_paint(f"DNS Updates: AUTO / every {default_poll} min", "green"))
    customize = _prompt("Customize DNS refresh? (y/N)", "N", "cyan")
    if customize.lower() in ("y", "yes"):
        value = _prompt("DNS refresh minutes", str(default_poll), "cyan")
        if not value.isdecimal() or int(value) not in INTERVALS:
            raise PortfwError(f"Allowed DNS refresh intervals: {INTERVALS}")
        poll = int(value)
    else:
        poll = default_poll
    return dict(dns_mode=mode, dns_poll=poll, dns_rotate=rotation,
                dns_addresses=addresses)


def _confirm_rule(source, target, dest, proto, dns):
    _heading("Review Forwarding Rule", "Validate all settings before applying", "magenta")
    _panel_border("┌", "─", "┐")
    _panel_row("Source port(s)", source)
    _panel_row("Destination", target)
    _panel_row("Destination port(s)", dest)
    _panel_row("Protocol", proto.upper(), "green")
    if dns:
        labels = {"off": "Single IP (OFF)", "timed": f"Timed / {dns['dns_rotate']} min",
                  "rr": "Per-Connection RR"}
        _panel_row("Traffic Distribution", labels[dns["dns_mode"]], "cyan")
        _panel_row("DNS Updates", f"AUTO / {dns['dns_poll']} min", "green")
    _panel_border("└", "─", "┘")
    return _prompt("Save and apply? (Y/n)", "Y", "yellow").lower() in ("y", "yes")


def _add():
    _heading("Add Forwarding", "Configure forwarding, DNS and balancing together", "green")
    source, target, dest, proto = _entry()
    options = _rule_dns_form(None, target)
    if not _confirm_rule(source, target, dest, proto, options):
        print(_paint("Cancelled. No changes made.", "yellow"))
        return
    change("add", argparse.Namespace(source=source, target=target, dest=dest,
                                     protocol=proto, **(options or {})))
    print(_paint("✓ Rule, DNS updates and balancing configured successfully.", "green"))


def _choose_id(records, action):
    if not records:
        raise PortfwError("No forwarding rules configured")
    list_rules(records)
    raw = _prompt(f"Select rule ID to {action}", color="yellow")
    if not raw.isdigit() or int(raw) not in {rule[0] for rule in records}:
        raise PortfwError("Rule ID not found")
    return int(raw)


def _edit():
    _heading("Edit Forwarding", "Ports, destination, DNS updates and balancing", "yellow")
    records = read_rules()
    id_ = _choose_id(records, "edit")
    selected = next(row for row in records if row[0] == id_)
    source, target, dest, proto = _entry((selected[1], selected[2], selected[3], selected[4]))
    existing = read_rule_dns().get(id_)
    if is_domain(target) and existing is None and target == selected[2]:
        existing = legacy_policy(selected, read_balance(), read_backends(),
                                 read_cache(), _dns_configured_minutes())
    options = _rule_dns_form(id_, target, existing)
    if not _confirm_rule(source, target, dest, proto, options):
        print(_paint("Cancelled. No changes made.", "yellow"))
        return
    change("edit", argparse.Namespace(id=id_, source=source, target=target,
                                      dest=dest, protocol=proto, **(options or {})))
    print(_paint(f"✓ Rule {id_} and DNS settings updated.", "green"))


def _delete():
    _heading("Delete Forwarding", "Remove one managed entry", "red")
    id_ = _choose_id(read_rules(), "delete")
    if _prompt(f"Delete rule {id_}? (y/N)", color="red").lower() != "y":
        print(_paint("Cancelled. No changes made.", "yellow"))
        return
    change("delete", argparse.Namespace(id=id_))
    print(_paint(f"✓ Rule {id_} removed.", "green"))


def _delete_all():
    _heading("Delete All", "Remove only Port Forward Manager rules", "red")
    list_rules(read_rules())
    if _prompt("Type DELETE to confirm", color="red") != "DELETE":
        print(_paint("Cancelled. No changes made.", "yellow"))
        return
    change("clear", argparse.Namespace())
    print(_paint("✓ Managed rules cleared.", "green"))


def _dns_configured_minutes():
    override = "/etc/systemd/system/portfw-dns-refresh.timer.d/override.conf"
    try:
        text = Path(override).read_text()
    except OSError:
        return 5
    for line in reversed(text.splitlines()):
        match = re.fullmatch(r"\s*OnUnitInactiveSec\s*=\s*(\d+)min\s*", line)
        if match:
            return int(match.group(1))
    return 5


def _dns_is_enabled():
    try:
        result = run(["systemctl", "is-enabled", "portfw-dns-refresh.timer"],
                     timeout=3, check=False)
    except PortfwError:
        return False
    return result.stdout.strip() == "enabled"


def _dns_settings():
    """Advanced read-only status and safe repair; no conflicting manual setup."""
    while True:
        _heading("DNS Settings", "Automatic per-rule DNS scheduling", "cyan")
        policies = read_rule_dns()
        records = read_rules()
        print("Scheduler: " + _paint("Active" if _dns_is_enabled() else "Inactive",
                                     "green" if _dns_is_enabled() else "yellow"))
        print(_paint("Scheduler tick: 1 minute (managed automatically)", "dim"))
        print()
        for rid, _, host, _, _ in records:
            if not is_domain(host):
                continue
            policy = policies.get(rid)
            if policy:
                label = f"Rule #{rid}: {host} / mode={policy['mode'].upper()} / DNS every {policy['poll']}min"
            else:
                label = f"Rule #{rid}: {host} / legacy DNS configuration"
            print(_paint(label, "cyan"))
        print()
        _menu_item("1", "Repair Scheduler", "Ensure DNS polling is enabled for domain rules", "green")
        _menu_item("0", "Back", "Return to main menu", "white")
        choice = _prompt("Select option", color="white")
        if choice == "0":
            return
        if choice == "1":
            try:
                _sync_dns_timer(records)
                print(_paint("✓ DNS scheduler checked.", "green"))
            except PortfwError as exc:
                print(_paint(f"ERROR: {exc}", "red"))
        else:
            print(_paint("Invalid menu option.", "red"))


def interactive():
    while True:
        try:
            records = read_rules()
            print_header(records)
            _menu_item("1", "Add Forwarding", "Create a new forwarding rule", "green")
            _menu_item("2", "Edit Forwarding", "Modify an existing rule", "yellow")
            _menu_item("3", "Delete Forwarding", "Remove one managed rule", "red")
            _menu_item("4", "List Forwarding", "Show all managed rules", "cyan")
            _menu_item("5", "Delete All", "Remove all managed forwarding rules", "red")
            _menu_item("6", "Reload Rules", "Reapply native maps and re-detect Primary IP", "magenta")
            _menu_item("7", "DNS Settings", "Advanced status / scheduler repair", "blue")
            _menu_item("8", "Refresh DNS Now", "Manually resolve domain destinations", "cyan")
            _menu_item("0", "Exit", "Close the manager", "white")
            print()
            choice = _prompt("Select option", color="white")
            if choice == "0":
                return
            if choice == "1":
                _add()
            elif choice == "2":
                _edit()
            elif choice == "3":
                _delete()
            elif choice == "4":
                list_rules(records)
            elif choice == "5":
                _delete_all()
            elif choice == "6":
                _heading("Reload Rules", "Rebuilding the managed native nftables table", "magenta")
                with locked():
                    apply(read_rules(), read_cache())
                print(_paint("✓ Native forwarding rules reloaded.", "green"))
            elif choice == "7":
                _dns_settings()
            elif choice == "8":
                _heading("Refresh DNS Now", "Check configured domains and update only if changed", "cyan")
                refresh_dns()
                print(_paint("✓ DNS refresh completed.", "green"))
            else:
                print(_paint("Invalid menu option.", "red"))
            if choice != "7":
                _pause()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        except (PortfwError, ValueError, OSError) as exc:
            print(_paint(f"ERROR: {exc}", "red"), file=sys.stderr)
            try:
                _pause()
            except (EOFError, KeyboardInterrupt):
                print()
                return


def main():
    parser = argparse.ArgumentParser(description="Native nftables port forwarding (staged opt-in)")
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="action")
    for action in ("add", "edit"):
        p = sub.add_parser(action)
        if action == "edit":
            p.add_argument("id", type=int)
        p.add_argument("source")
        p.add_argument("target")
        p.add_argument("dest")
        p.add_argument("protocol", choices=list(PROTOCOLS))
    for action in ("delete",):
        sub.add_parser(action).add_argument("id", type=int)
    for action in ("clear", "list", "apply", "reload", "dns-refresh", "render", "check"):
        sub.add_parser(action)
    timer = sub.add_parser("timer")
    timer.add_argument("--minutes", type=int, choices=INTERVALS)
    group = timer.add_mutually_exclusive_group()
    group.add_argument("--enable", action="store_true")
    group.add_argument("--disable", action="store_true")
    balance = sub.add_parser("balance")
    balance.add_argument("--enable", type=int, metavar="RULE_ID")
    balance.add_argument("--disable", type=int, metavar="RULE_ID")
    balance.add_argument("--minutes", type=int, choices=INTERVALS, default=5)
    balance.add_argument("--mode", choices=("timed", "round-robin"), default="timed")
    args = parser.parse_args()
    try:
        if args.action in ("list", "render", "check") or (args.action == "balance" and args.enable is None and args.disable is None):
            records = read_rules()
            if args.action == "list":
                list_rules(records)
            elif args.action == "render":
                print(nft_config(records, read_cache(), "192.0.2.1", existing=False,
                                 balance=read_balance(), backends=read_backends(), policies=read_rule_dns()))
            elif args.action == "balance":
                show_balance()
            else:
                read_balance()
                read_backends()
                read_rule_dns()
                print("State validation OK")
            return
        if os.geteuid() != 0:
            raise PortfwError("Root is required for modifying firewall/state")
        if args.action in ("add", "edit", "delete", "clear"):
            change(args.action, args)
        elif args.action in ("apply", "reload"):
            with locked():
                apply(read_rules(), read_cache())
            print("Rules applied")
        elif args.action == "dns-refresh":
            refresh_dns()
        elif args.action == "timer":
            configure_timer(args.minutes, True if args.enable else False if args.disable else None)
        elif args.action == "balance":
            if args.enable is not None and args.disable is not None:
                raise PortfwError("Choose --enable or --disable, not both")
            if args.enable is not None:
                configure_balance(args.enable, True, args.minutes, mode=args.mode)
            elif args.disable is not None:
                configure_balance(args.disable, False)
        elif args.action is None:
            interactive()
        else:
            parser.error("unknown action")
    except PortfwError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
